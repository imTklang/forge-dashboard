# --- Banco ---
DATABASE_URL=postgresql://forge:forge@localhost:5432/forge

# --- Auth da UI (senha única) ---
FORGE_PASSWORD=troque-esta-senha
# Segredo para assinar o cookie de sessão (openssl rand -hex 32)
SESSION_SECRET=

# --- WHOOP (integração futura; deixe vazio por enquanto) ---
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:3000/api/whoop/callback
# Chave AES-256-GCM, 32 bytes em hex (openssl rand -hex 32)
TOKEN_ENCRYPTION_KEY=

# --- GitHub (token pessoal, leitura de repos) ---
GITHUB_TOKEN=
